# Copy this file to .env on the server and fill it in. Never commit .env.

# --- App ---
APP_NAME=Orvellaz Mailer
BRAND_NAME=Orvellaz
# Public address of the app, used in unsubscribe links. No trailing slash.
BASE_URL=https://bulk.orvellaz.xyz
PORT=3100
# Time zone for the daily limit and the morning restart.
TIMEZONE=Africa/Lagos
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=change-me
# Where the database file lives.
DATA_DIR=./data

# --- Admin login ---
ADMIN_EMAIL=mateo@orvellaz.xyz
# Set the password with: npm run set-password

# --- Mail server (GoDaddy Professional Email) ---
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=mateo@orvellaz.xyz
SMTP_PASS=
